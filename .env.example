# Microsoft Graph (OneDrive) — delegated auth (refresh token cache)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_TOKEN_CACHE_PATH=ms_graph_token_cache.json

# Master CSV on signed-in user's OneDrive (ID preferred; path is fallback)
MS_FILE_ID=
MS_FILE_PATH=Projects/Emergency Alerts/Emergency_Alert_Registrations.csv

# SFTP (Everbridge) — used when EVERBRIDGE_TRANSPORT=sftp
SFTP_HOST=sftp-aws-us3.everbridge.net
SFTP_PORT=22
SFTP_USERNAME=
SFTP_KEY_PATH=Apex.key
SFTP_REMOTE_DIR=/update
SFTP_REMOTE_FILENAME=Emergency_Alert_Registrations.csv
SFTP_REMOTE_DELETE_DIR=/delete
SFTP_REMOTE_DELETE_FILENAME=Emergency_Alert_Registrations.csv
DELETE_STAGING_CSV=everbridge_delete.csv

# Everbridge transport: sftp (default). api planned — see docs/FUTURE_ARCHITECTURE.md
EVERBRIDGE_TRANSPORT=sftp

# Behavior
ALLOW_LOCAL_FALLBACK=false
SKIP_GRAPH_DOWNLOAD=false
GRAPH_MAX_RETRIES=3
SFTP_MAX_RETRIES=3
SFTP_TIMEOUT_SECONDS=60

# Scheduler (defaults: Friday 10:00 AM Eastern)
SYNC_TIMEZONE=America/New_York
SYNC_DAY_OF_WEEK=fri
SYNC_HOUR=10
SYNC_MINUTE=0

# Alerting — Teams webhook expects Power Automate adaptive-card payload
TEAMS_WEBHOOK_URL=
TEAMS_NOTIFY_ON_SUCCESS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
